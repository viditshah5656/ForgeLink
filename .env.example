# ForgeLink local development example
# Copy to .env only when using the command-line/server workflow.
# The desktop app stores runtime configuration and secrets outside the repository.

# Local MCP/backend ports
PORT=24024
DASHBOARD_PORT=24025

# Folder ForgeLink may expose in command-line mode.
# Windows example: C:\Coding
# macOS/Linux example: /Users/you/Coding
ALLOWED_ROOT=C:\Coding

# Public origin used for OAuth/server-url mode.
PUBLIC_URL=http://localhost:24024

# Required for OAuth mode. Replace locally with a long random password.
OAUTH_LOGIN_PASSWORD=replace-with-a-long-random-password

# Set to 1 only when using a trusted no-auth transport such as the local secure-tunnel path.
NO_AUTH=0

# Set to 0 to disable advanced ForgeLink tool surfaces.
ADVANCED_TOOLS=1

# Optional overrides. Leave blank to use ForgeLink defaults.
MCP_DATA_DIR=
MCP_ASSET_DIR=
FORGELINK_DOWNLOAD_DIR=
FORGELINK_MAX_AGENT_CONCURRENCY=

# Optional: used only by setup/build scripts for authenticated GitHub downloads.
# Never commit a real token.
GITHUB_TOKEN=
